ro.bluetooth.a2dp_offload.supported=false
ro.bluetooth.emb_wp_mode=false
ro.bluetooth.wipower=false
ro.vendor.bluetooth.wipower=false
vendor.qcom.bluetooth.soc=cherokee

# ========================
# Camera Configuration
# ========================
camera.aux.packagelist=net.sourceforge.opencamera,org.codeaurora.snapcam,com.fihtdc.fqc
camera.disable_zsl_mode=0
camera.panorama.quality=middle
persist.capture.burst.exposures=0,-9,9
persist.camera.ffcolor=FFBB77
persist.camera.ffcolor.th=3500
persist.camera.ffcolor.th2=4500
persist.camera.ffcolor.lev2=FFE4CA
persist.camera.ffcolor.lev3=ffdcb9
persist.vendor.camera.fdvideo=1
persist.vendor.camera.ven_hdr=0
persist.vendor.camera.isp.turbo=1
vendor.camera.hal1.packagelist=com.dw.btime
camera.ans.yproc.int.main=20,20,20,20
camera.ans.uvproc.int.main=20,20,20,20
camera.ans.scene.contract.main=0,0,0,0
vendor.camera.aux.packagelist=org.codeaurora.snapcam,com.blackberry.camera,com.blackberry.camera.debug,com.android.mmi
vendor.camera.c2d.rotation=1

# ========================
# Dalvik VM / ART Settings
# ========================
dalvik.vm.heapgrowthlimit=256m
dalvik.vm.heapmaxfree=8m
dalvik.vm.heapminfree=512k
dalvik.vm.heapsize=512m
dalvik.vm.heapstartsize=8m
dalvik.vm.heaptargetutilization=0.75
dalvik.vm.appimageformat=lz4
dalvik.vm.dex2oat-Xms=64m
dalvik.vm.dex2oat-Xmx=512m
dalvik.vm.dexopt.secondary=true
dalvik.vm.image-dex2oat-Xms=64m
dalvik.vm.image-dex2oat-Xmx=64m
dalvik.vm.usejit=true
dalvik.vm.usejitprofiles=true
pm.dexopt.ab-ota=speed-profile
pm.dexopt.bg-dexopt=speed-profile
pm.dexopt.boot=verify
pm.dexopt.first-boot=quicken
pm.dexopt.inactive=verify
pm.dexopt.install=quicken
pm.dexopt.shared=speed

# ========================
# Display & Graphics
# ========================
ro.opengles.version=196610
ro.hardware.egl=adreno
ro.hardware.vulkan=adreno

# ========================
# DRM / Media
# ========================
drm.service.enabled=true
debug.stagefright.omx_default_rank.sw-audio=1
debug.stagefright.omx_default_rank=0
ro.com.widevine.cachesize=16777216

# ========================
# Keyguard / Lock
# ========================
keyguard.no_require_sim=true

# ========================
# Multi-SIM / Telephony
# ========================
persist.radio.multisim.config=dsds
ro.telephony.iwlan_operation_mode=legacy

# ========================
# NTP / Time
# ========================
persist.backup.ntpServer=0.pool.ntp.org

# ========================
# Radio / Modem / Network
# ========================
persist.radio.qcom_ext_enable=true
persist.vendor.radio.uicc_se_enabled=false
persist.vendor.radio.apm_sim_not_pwdn=1
persist.vendor.radio.custom_ecc=1
persist.vendor.radio.rat_on=combine
persist.vendor.radio.sib16_support=1
persist.vendor.radio.procedure_bytes=SKIP
persist.vendor.radio.sap_silent_pin=1
persist.radio.schd.cache=3500
ro.carrier=unknown

# ========================
# RIL (Radio Interface Layer)
# ========================
rild.libpath=/system/vendor/lib64/libril-qc-qmi-1.so

# ========================
# Sensors
# ========================
ro.vendor.sdk.sensors.gestures=false
ro.vendor.sensors.cmc=false
ro.vendor.sensors.facing=false

# ========================
# Shutdown
# ========================
ro.build.shutdown_timeout=0
sys.vendor.shutdown.waittime=500

# ========================
# Storage / FRP
# ========================
ro.frp.pst=/dev/block/bootdevice/by-name/frp

# ========================
# System Properties & Debug
# ========================
af.fast_track_multiplier=2
debug.atrace.tags.enableflags=0
persist.sys.bbsys=on
persist.sys.disable_rescue=true
persist.sys.enable_rescue=false
persist.sys.screenmode=1
persist.sys.ssr.restart_level=ALL_ENABLE
ro.logdumpd.enabled=0
ro.setupwizard.mode=OPTIONAL
ro.setupwizard.require_network=any
ro.config.alarm_alert=Alarm_Beep_03.ogg
ro.config.notification_sound=BBRY_Essential.ogg
ro.config.ringtone=Spirit.ogg
ro.control_privapp_permissions=log
ro.cp_system_other_odex=1
ro.dalvik.vm.native.bridge=0
sys.autosuspend.timeout=500000
video.disable.ubwc=1
vendor.video.disable.ubwc=1

# ========================
# Boot & Device Info
# ========================
ro.boot.flash.locked=1
ro.boot.vr=0
ro.boot.wificountrycode=US
ro.bt.bdaddr_path=/proc/bt_mac
ro.oem_unlock_supported=true
ro.opa.eligible_device=true

# ========================
# Branding
# ========================
ro.vendor.product.brand=blackberry
ro.vendor.product.manufacturer=BlackBerry

# ========================
# Miscellaneous
# ========================
persist.env.fastdorm.enabled=true
persist.gsmapp.ezincall.video=false
persist.data.iwlan.enable=true
persist.vendor.qcomsysd.enabled=1
persist.vendor.stbDebugCtlEnable=1
vendor.hw.fm.init=0
vendor.fm.a2dp.conc.disabled=true
vendor.power.pasr.enabled=true
vendor.voice.path.for.pcm.voip=false
ro.af.client_heap_size_kbyte=7168
